{
  "name": "whale-qwq",
  "version": "0.2.5",
  "description": "轴伊 Joi 双衣装主题（Joi-Flowers / Joi-Library）for DeepSeek Harness 0.2.x — unofficial, non-commercial fan theme plugin",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "vtuber",
    "joi",
    "virtuareal"
  ],
  "author": "Jisakuna",
  "license": "MIT",
  "homepage": "https://github.com/Jisakuna/Whale-QwQ#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jisakuna/Whale-QwQ.git"
  },
  "bugs": {
    "url": "https://github.com/Jisakuna/Whale-QwQ/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE-ASSETS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "gen": "node scripts/gen-baseline.mjs && node scripts/gen-assets.mjs",
    "build": "tsdown",
    "build:full": "npm run gen && tsdown",
    "verify": "node scripts/verify-4q.mjs capture/*.json",
    "prepublishOnly": "npm run build && npm run verify",
    "verify:static": "node scripts/verify-4q.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
