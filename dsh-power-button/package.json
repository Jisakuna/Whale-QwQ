{
  "name": "dsh-power-button",
  "version": "0.1.0",
  "description": "侧栏底部的电源键：一键结束 dsh web 进程（loopback-only）— for DeepSeek Harness 0.2.x",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shutdown",
    "power"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@types/node": "^24.13.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
